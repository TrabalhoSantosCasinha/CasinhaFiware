# Copie para .env e ajuste.

# Domínio que aponta para o IP público da VM.
# Sem domínio próprio? Use sslip.io: troque os pontos do IP por traços.
# Ex.: IP 129.151.40.12  ->  casinha.129-151-40-12.sslip.io
DOMAIN=casinha.SEU-IP-COM-TRACOS.sslip.io

# Domínio do frontend na Vercel (sem barra no final). Vários? separe por vírgula.
CORS_ORIGIN=https://SEU-PROJETO.vercel.app

# Precisa ser igual à do casinha.ino
APIKEY=casinha-fiap-7k2q9

# Broker MQTT público (o mesmo que o ESP32 usa)
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883

# Versões das imagens FIWARE
ORION_VERSION=3.10.1
ULTRALIGHT_VERSION=3.4.0
STH_COMET_VERSION=2.11.0
MONGO_VERSION=4.4
