# Copie para .env e ajuste.

# Onde vai rodar:  pc = seu computador + ngrok   |   vm = VM com IP público + Caddy
COMPOSE_PROFILES=pc

# --- Opção pc (ngrok) ---
# Token em https://dashboard.ngrok.com/get-started/your-authtoken
NGROK_AUTHTOKEN=cole-seu-token-aqui
# Seu domínio fixo grátis em https://dashboard.ngrok.com/domains (com https://)
NGROK_URL=https://SEU-DOMINIO.ngrok-free.app

# --- Opção vm (Caddy) ---
# Domínio que aponta para o IP da VM. Sem domínio? sslip.io: IP 129.151.40.12 -> casinha.129-151-40-12.sslip.io
DOMAIN=

# Domínio do frontend na Vercel (sem barra no final). Vários? separe por vírgula.
CORS_ORIGIN=https://SEU-PROJETO.vercel.app

# Precisa ser igual à do casinha.ino
APIKEY=casinha-fiap-7k2q9

# Broker MQTT público (o mesmo que o ESP32 usa)
MQTT_HOST=broker.hivemq.com
MQTT_PORT=1883

# Versões das imagens FIWARE
ORION_VERSION=3.10.1
ULTRALIGHT_VERSION=3.4.0
STH_COMET_VERSION=2.11.0
MONGO_VERSION=4.4
